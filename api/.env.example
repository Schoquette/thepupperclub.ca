APP_NAME="The Pupper Club"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=UTC
APP_URL=https://api.thepupperclub.ca

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
APP_MAINTENANCE_STORE=database

DISPLAY_TIMEZONE=America/Vancouver

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=pupper_club
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# ── Mail ─────────────────────────────────────────────────────────────────────
#
# LOCAL DEVELOPMENT (zero setup — emails written to storage/logs/laravel.log):
#   MAIL_MAILER=log
#
# PRODUCTION — Resend API (recommended, bypasses SMTP port restrictions):
#   MAIL_MAILER=resend
#   Requires RESEND_API_KEY below + verified domain in Resend dashboard
#
# ALTERNATIVE — Resend SMTP relay (if API driver has issues):
#   MAIL_MAILER=smtp
#   MAIL_HOST=smtp.resend.com
#   MAIL_PORT=587
#   MAIL_USERNAME=resend
#   MAIL_PASSWORD=re_your_api_key_here
#   MAIL_ENCRYPTION=tls
#
MAIL_MAILER=resend
MAIL_FROM_ADDRESS="sophie@thepupperclub.ca"
MAIL_FROM_NAME="${APP_NAME}"

RESEND_INBOUND_ADDRESS=reply@thepupperclub.ca

# Shared secret guarding the inbound-email webhook. Generate a random
# value and append it as ?key=<value> to the webhook URL configured in
# the Resend dashboard (https://.../api/webhooks/email?key=<value>) —
# without a matching key, POSTs to that endpoint are rejected with 403.
RESEND_INBOUND_WEBHOOK_SECRET=

# Shared secret guarding scheduled-task trigger URLs (e.g. the report card
# photo purge), hit on a schedule by a GitHub Actions cron workflow since
# GoDaddy has no CLI/SSH access to run `php artisan schedule:run`. Must
# match the CRON_TRIGGER_SECRET GitHub Actions secret.
CRON_TRIGGER_SECRET=

STRIPE_KEY=
STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=

# Claude (Anthropic) API — used for AI receipt-photo extraction in Accounting.
# Get a key at https://console.anthropic.com. Not yet set on production —
# add via GoDaddy's env panel; until then, receipt scanning degrades to
# "enter manually" with a clear message, and manual entry/spreadsheet
# import in Accounting work regardless.
ANTHROPIC_API_KEY=

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# CORS — allowed origins (comma-separated)
SANCTUM_STATEFUL_DOMAINS=localhost:5173,thepupperclub.ca,app.thepupperclub.ca

# Used in invitation email links — set to your web app URL
# Local:      http://localhost:5173
# Production: https://thepupperclub.ca
FRONTEND_URL=http://localhost:5173
